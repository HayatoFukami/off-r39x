// SPEC-180 13.1 / 13.2, SPEC-140 21 / 22 / 22.1, SEC-WEB-003..009, SEC-WEB-026: writes apps/web/dist/_headers
// after the web build. The CSP allows exactly the inline scripts found in the built HTML (by SHA-256 hash, never
// 'unsafe-inline') and the Sponsor image origins of SPONSOR_IMAGE_ALLOWED_ORIGINS; every other value is fixed here.
// Pages applies the file as static headers: no Pages Functions and no Web-side server (DEV-WEB-003).
// Runs under plain `node` (type stripping): erasable TypeScript syntax only, node: built-ins only.
// Usage: node scripts/generate-web-headers.mts [--dist <dir>] [--check]
// Exit codes: 0 success, 1 validation / artifact error, 2 usage error. Output never contains an input value.
import { createHash } from "node:crypto";
import { existsSync, readdirSync, readFileSync, statSync, writeFileSync, writeSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const USAGE = "USAGE node scripts/generate-web-headers.mts [--dist <dir>] [--check]";
const HEADERS_COMMENT = "# Generated by scripts/generate-web-headers.mts. Do not edit.";

/** The protected prefixes of SEC-WEB-009. Each is written as the prefix itself and as `<prefix>/*`. */
const PROTECTED_PREFIXES = ["/account", "/auth", "/purchase", "/mypage", "/admin", "/staff"];

const NO_STORE = "no-store, private, max-age=0";

/** Headers of the `/*` rule other than the CSP, in file order (SPEC-140 22; Permissions-Policy of a normal page 22.1). */
const BASE_HEADERS: readonly (readonly [string, string])[] = [
  ["X-Content-Type-Options", "nosniff"],
  ["Referrer-Policy", "strict-origin-when-cross-origin"],
  ["X-Frame-Options", "DENY"],
  ["Strict-Transport-Security", "max-age=63072000; includeSubDomains"],
  ["Cross-Origin-Opener-Policy", "same-origin"],
  ["Permissions-Policy", "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()"],
];

// ---- CLI ------------------------------------------------------------------------------------

interface Options {
  readonly dist: string;
  readonly check: boolean;
}

class CliExit extends Error {
  readonly code: number;
  constructor(code: number) {
    super("exit");
    this.code = code;
  }
}

function runCli(run: () => void): void {
  try {
    run();
  } catch (error) {
    if (!(error instanceof CliExit)) throw error;
    process.exitCode = error.code;
  }
}

function fail(message: string, code: number): never {
  writeSync(2, `${message}\n`);
  throw new CliExit(code);
}

function parseArgs(argv: readonly string[]): Options {
  let dist = resolve(dirname(fileURLToPath(import.meta.url)), "..", "apps", "web", "dist");
  let check = false;
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--check") {
      check = true;
    } else if (arg === "--dist") {
      const value = argv[i + 1];
      if (value === undefined || value.startsWith("--")) fail(USAGE, 2);
      dist = resolve(value);
      i += 1;
    } else {
      fail(USAGE, 2);
    }
  }
  return { dist, check };
}

// ---- Sponsor image origins (SEC-WEB-026, SPEC-180 13.2) -----------------------------------------

/** Never include the offending value in the message. */
function originError(index?: number): never {
  const suffix = index === undefined ? "" : ` index=${index}`;
  return fail(`ERROR sponsor-image-origin-invalid${suffix}`, 1);
}

function normalizeOrigin(value: string): string | undefined {
  // Characters that would let a value carry more than an origin, or that URL parsing silently repairs.
  if (/[\s\\?#@\p{Cc}]/u.test(value)) return undefined;
  let url: URL;
  try {
    url = new URL(value);
  } catch {
    return undefined;
  }
  if (url.protocol !== "https:") return undefined;
  if (url.username !== "" || url.password !== "") return undefined;
  if (url.port !== "") return undefined; // ":443" is normalised away by the parser; any other port stays.
  if (url.pathname !== "/" || url.search !== "" || url.hash !== "") return undefined;
  const host = url.hostname; // lower-case, punycode, IPv4 normalised to dotted decimal
  if (!/^[a-z0-9-]+(?:\.[a-z0-9-]+)*$/.test(host)) return undefined; // no IPv6 literal, no "*", no escapes
  if (/^\d+(?:\.\d+){3}$/.test(host)) return undefined; // IPv4 literal
  if (host === "localhost" || host.endsWith(".localhost") || host.endsWith(".local")) {
    return undefined;
  }
  return url.origin;
}

function readImageOrigins(): string[] {
  const raw = process.env.SPONSOR_IMAGE_ALLOWED_ORIGINS;
  if (raw === undefined || raw === "") return [];
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    return originError();
  }
  if (!Array.isArray(parsed)) return originError();
  const origins: string[] = [];
  parsed.forEach((element: unknown, index) => {
    const origin = typeof element === "string" ? normalizeOrigin(element) : undefined;
    if (origin === undefined) originError(index);
    if (!origins.includes(origin)) origins.push(origin);
  });
  return origins;
}

// ---- built HTML ---------------------------------------------------------------------------------

const posix = (path: string): string => path.split("\\").join("/");

function htmlFiles(dir: string): string[] {
  return readdirSync(dir, { withFileTypes: true })
    .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
    .flatMap((entry) => {
      const full = join(dir, entry.name);
      if (entry.isDirectory()) return htmlFiles(full);
      return entry.isFile() && entry.name.toLowerCase().endsWith(".html") ? [full] : [];
    });
}

type Scan =
  | { readonly ok: true; readonly inlineScripts: readonly string[] }
  | { readonly ok: false; readonly reason: "inline-handler" | "html-unparsable" };

const isSpace = (ch: string | undefined): boolean => ch !== undefined && /[\s]/.test(ch);

function isInlineCodeAttribute(name: string, value: string): boolean {
  if (/^on[a-z]/i.test(name)) return true;
  // Browsers drop whitespace and control characters inside the scheme of a URL.
  const compact = value.replace(/[\s\p{Cc}]/gu, "").toLowerCase();
  return compact.startsWith("javascript:");
}

/**
 * A small HTML tokenizer: enough to tell element tags from text, comments and raw-text (script / style) bodies.
 * It collects the bodies of script elements without a `src`, and rejects inline event handlers and
 * `javascript:` URLs (they conflict with `script-src-attr 'none'`).
 */
function scanHtml(html: string): Scan {
  const inlineScripts: string[] = [];
  let i = 0;
  while (i < html.length) {
    const open = html.indexOf("<", i);
    if (open < 0) break;
    if (html.startsWith("<!--", open)) {
      const end = html.indexOf("-->", open + 4);
      if (end < 0) return { ok: false, reason: "html-unparsable" };
      i = end + 3;
      continue;
    }
    const next = html.charAt(open + 1);
    if (next === "!" || next === "?") {
      const end = html.indexOf(">", open + 2);
      if (end < 0) return { ok: false, reason: "html-unparsable" };
      i = end + 1;
      continue;
    }
    if (!/[A-Za-z]/.test(next)) {
      i = open + 1;
      continue;
    }
    // An element start tag: name, then attributes up to the closing ">".
    let p = open + 1;
    while (p < html.length && /[^\s/>]/.test(html.charAt(p))) p += 1;
    const tag = html.slice(open + 1, p).toLowerCase();
    let hasSrc = false;
    let closed = false;
    while (p < html.length) {
      while (isSpace(html[p]) || html[p] === "/") p += 1;
      if (html[p] === ">") {
        p += 1;
        closed = true;
        break;
      }
      const nameStart = p;
      while (p < html.length && /[^\s=>/]/.test(html.charAt(p))) p += 1;
      const name = html.slice(nameStart, p);
      while (isSpace(html[p])) p += 1;
      let value = "";
      if (html[p] === "=") {
        p += 1;
        while (isSpace(html[p])) p += 1;
        const quote = html[p];
        if (quote === '"' || quote === "'") {
          const end = html.indexOf(quote, p + 1);
          if (end < 0) return { ok: false, reason: "html-unparsable" };
          value = html.slice(p + 1, end);
          p = end + 1;
        } else {
          const valueStart = p;
          while (p < html.length && /[^\s>]/.test(html.charAt(p))) p += 1;
          value = html.slice(valueStart, p);
        }
      }
      if (name === "") {
        p += 1; // a stray character: keep moving
        continue;
      }
      if (isInlineCodeAttribute(name, value)) return { ok: false, reason: "inline-handler" };
      if (name.toLowerCase() === "src") hasSrc = true;
    }
    if (!closed) return { ok: false, reason: "html-unparsable" };
    if (tag === "script" || tag === "style") {
      const closing = new RegExp(`</${tag}`, "ig");
      closing.lastIndex = p;
      const end = closing.exec(html)?.index ?? -1;
      if (end < 0) return { ok: false, reason: "html-unparsable" };
      if (tag === "script" && !hasSrc) inlineScripts.push(html.slice(p, end));
      const close = html.indexOf(">", end);
      if (close < 0) return { ok: false, reason: "html-unparsable" };
      i = close + 1;
    } else {
      i = p;
    }
  }
  return { ok: true, inlineScripts };
}

function inlineScriptHashes(dist: string): string[] {
  const errors: string[] = [];
  const hashes = new Set<string>();
  for (const file of htmlFiles(dist)) {
    const result = scanHtml(readFileSync(file, "utf8"));
    if (!result.ok) {
      errors.push(`ERROR ${result.reason} ${posix(relative(dist, file))}`);
      continue;
    }
    for (const body of result.inlineScripts) {
      hashes.add(`sha256-${createHash("sha256").update(body, "utf8").digest("base64")}`);
    }
  }
  if (errors.length > 0) {
    writeSync(2, `${errors.join("\n")}\n`);
    throw new CliExit(1);
  }
  return [...hashes].sort();
}

// ---- _headers -----------------------------------------------------------------------------------

/** SPEC-140 21 baseline. connect-src is 'self' only until the API exists; there are no placeholders. */
function contentSecurityPolicy(hashes: readonly string[], imgOrigins: readonly string[]): string {
  const script = ["'self'", ...hashes.map((hash) => `'${hash}'`)].join(" ");
  const img = ["'self'", "data:", "blob:", ...imgOrigins].join(" ");
  return [
    "default-src 'self'",
    `script-src ${script}`,
    "script-src-attr 'none'",
    "style-src 'self' 'unsafe-inline'",
    `img-src ${img}`,
    "font-src 'self'",
    "connect-src 'self'",
    "object-src 'none'",
    "base-uri 'none'",
    "frame-ancestors 'none'",
    "frame-src 'none'",
    "form-action 'self'",
    "manifest-src 'self'",
    "worker-src 'self' blob:",
    "media-src 'self' blob:",
    "upgrade-insecure-requests",
  ].join("; ");
}

function renderHeaders(hashes: readonly string[], imgOrigins: readonly string[]): string {
  const rules: string[] = [
    [
      "/*",
      `  Content-Security-Policy: ${contentSecurityPolicy(hashes, imgOrigins)}`,
      ...BASE_HEADERS.map(([name, value]) => `  ${name}: ${value}`),
    ].join("\n"),
    // The protected rules add no-store, Pragma and Referrer-Policy: no-referrer. The Referrer-Policy of the `/*`
    // rule is joined with it by comma (Pages and serve-web-dist.mts do the same); the last token, no-referrer, wins.
    ...PROTECTED_PREFIXES.flatMap((prefix) => [prefix, `${prefix}/*`]).map((path) =>
      [
        path,
        `  Cache-Control: ${NO_STORE}`,
        "  Pragma: no-cache",
        "  Referrer-Policy: no-referrer",
      ].join("\n"),
    ),
  ];
  return `${HEADERS_COMMENT}\n${rules.join("\n\n")}\n`;
}

function isDirectory(path: string): boolean {
  try {
    return statSync(path).isDirectory();
  } catch {
    return false;
  }
}

function main(): void {
  const { dist, check } = parseArgs(process.argv.slice(2));
  if (!isDirectory(dist) || !existsSync(join(dist, "index.html"))) {
    fail("ERROR index-missing", 1);
  }
  const imgOrigins = readImageOrigins();
  const hashes = inlineScriptHashes(dist);
  const content = renderHeaders(hashes, imgOrigins);
  const target = join(dist, "_headers");
  if (check) {
    const current = existsSync(target) ? readFileSync(target, "utf8") : undefined;
    if (current !== content) fail("ERROR headers-stale", 1);
  } else {
    writeFileSync(target, content, "utf8");
  }
  process.stdout.write(
    `OK headers inline-scripts=${hashes.length} img-origins=${imgOrigins.length}\n`,
  );
}

runCli(main);
