  "constraints": [
    [
      "audit_events",
      "ck_audit_events_actor_type",
      "c",
      "CHECK ((actor_type = ANY (ARRAY['GUEST'::text, 'AUTHENTICATED_USER'::text, 'STAFF'::text, 'ADMINISTRATOR'::text, 'SYSTEM_WORKER'::text, 'SCHEDULED_RECONCILIATION'::text, 'EXTERNAL_PROVIDER'::text, 'INFRASTRUCTURE_OPERATOR'::text])))",
      true,
      false,
      false
    ],
    [
      "audit_events",
      "ck_audit_events_audit_event_type",
      "c",
      "CHECK ((audit_event_type = ANY (ARRAY['PRIVILEGED_OPERATION'::text, 'PRIVILEGED_OPERATION_DENIED'::text, 'BUSINESS_EFFECT'::text, 'RECOVERY_EXECUTION'::text, 'SECURITY_SENSITIVE_OPERATION'::text, 'EMERGENCY_ADMIN_RECOVERY'::text])))",
      true,
      false,
      false
    ],
    [
      "audit_events",
      "ck_audit_events_audit_result",
      "c",
      "CHECK ((audit_result = ANY (ARRAY['REQUESTED'::text, 'AUTHORIZED'::text, 'REJECTED'::text, 'COMMITTED'::text, 'NOOP'::text, 'PENDING'::text, 'UNKNOWN'::text, 'FAILED'::text])))",
      true,
      false,
      false
    ],
    [
      "audit_events",
      "ck_audit_events_precondition_result",
      "c",
      "CHECK ((precondition_result = ANY (ARRAY['PASSED'::text, 'FAILED'::text, 'NOT_APPLICABLE'::text, 'UNKNOWN'::text])))",
      true,
      false,
      false
    ],
    ["audit_events", "pk_audit_events", "p", "PRIMARY KEY (id)", true, false, false],
    [
      "audit_events",
      "uq_audit_events_audit_event_id",
      "u",
      "UNIQUE (audit_event_id)",
      true,
      false,
      false
    ],
    [
      "business_profiles",
      "ck_business_profiles_display_name",
      "c",
      "CHECK (((display_name IS NULL) OR ((char_length(display_name) >= 1) AND (char_length(display_name) <= 80))))",
      true,
      false,
      false
    ],
    ["business_profiles", "pk_business_profiles", "p", "PRIMARY KEY (id)", true, false, false],
    [
      "business_profiles",
      "uq_business_profiles_auth_subject",
      "u",
      "UNIQUE (auth_subject)",
      true,
      false,
      false
    ],
    [
      "business_profiles",
      "uq_business_profiles_public_ref",
      "u",
      "UNIQUE (public_ref)",
      true,
      false,
      false
    ],
    [
      "role_assignments",
      "ck_role_assignments_revocation",
      "c",
      "CHECK ((((state = 'ACTIVE'::text) AND (revoked_at IS NULL) AND (revoked_by_profile_id IS NULL)) OR ((state = 'REVOKED'::text) AND (revoked_at IS NOT NULL))))",
      true,
      false,
      false
    ],
    [
      "role_assignments",
      "ck_role_assignments_role",
      "c",
      "CHECK ((role = ANY (ARRAY['STAFF'::text, 'ADMINISTRATOR'::text])))",
      true,
      false,
      false
    ],
    [
      "role_assignments",
      "ck_role_assignments_state",
      "c",
      "CHECK ((state = ANY (ARRAY['ACTIVE'::text, 'REVOKED'::text])))",
      true,
      false,
      false
    ],
    [
      "role_assignments",
      "fk_role_assignments_granted_by_profile",
      "f",
      "FOREIGN KEY (granted_by_profile_id) REFERENCES app.business_profiles(id) ON DELETE RESTRICT",
      true,
      false,
      false
    ],
    [
      "role_assignments",
      "fk_role_assignments_profile",
      "f",
      "FOREIGN KEY (profile_id) REFERENCES app.business_profiles(id) ON DELETE RESTRICT",
      true,
      false,
      false
    ],
    [
      "role_assignments",
      "fk_role_assignments_revoked_by_profile",
      "f",
      "FOREIGN KEY (revoked_by_profile_id) REFERENCES app.business_profiles(id) ON DELETE RESTRICT",
      true,
      false,
      false
    ],
    ["role_assignments", "pk_role_assignments", "p", "PRIMARY KEY (id)", true, false, false],
    [
      "role_assignments",
      "uq_role_assignments_public_ref",
      "u",
      "UNIQUE (public_ref)",
